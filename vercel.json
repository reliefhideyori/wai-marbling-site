{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "wai-marbling-site.vercel.app"
        }
      ],
      "destination": "https://www.wai-marbling.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "wai-marbling-site.vercel.app"
        }
      ],
      "destination": "https://www.wai-marbling.com/:path*",
      "permanent": true
    }
  ]
}
